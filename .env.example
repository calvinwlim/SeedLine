# Root reference for environment variables. Each app reads its own .env:
#   - apps/api/.env  (copy from apps/api/.env.example)
#   - apps/web/.env  (copy from apps/web/.env.example)
#
# The values below mirror the docker-compose.yml defaults for local dev.

# API
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://openmat:openmat@localhost:5432/openmat
REDIS_URL=redis://localhost:6379
WEB_ORIGIN=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000/api
