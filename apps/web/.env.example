# --- Data source -----------------------------------------------------------
# `mock`  (default) runs the web app entirely on built-in fixtures — no API,
#          no database, no Docker. Best for frontend development.
# `live`  talks to the NestJS API for the endpoints it serves (events list)
#          and falls back to mock data for the rest.
NEXT_PUBLIC_DATA_SOURCE=mock

# Base URL of the SeedLine API (only used when NEXT_PUBLIC_DATA_SOURCE=live).
# Note the /api global prefix.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
