{
  "name": "seedline",
  "version": "0.1.0",
  "private": true,
  "description": "Tournament & competition management platform for grappling and combat sports",
  "license": "UNLICENSED",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@seedline/web...",
    "dev:api": "turbo run dev --filter=@seedline/api...",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "db:generate": "npm run db:generate --workspace @seedline/api",
    "db:migrate": "npm run db:migrate --workspace @seedline/api",
    "db:push": "npm run db:push --workspace @seedline/api",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.5.4"
  }
}
